ntree     = 500,
nodesize  = 5,
splitrule = "logrankscore"
)
imputed_vals <- impute(model)[[val_col]]
df %>% mutate("{val_col}" := imputed_vals)
}
# --- Run imputation for all LOD columns ---
cI_imputed <- reduce(lod_cols_cI, impute_lod_col, .init = cI_clean)
# --- Fixed impute function: negate trick for left-censoring ---
impute_lod_col <- function(df, target_col) {
val_col <- paste0(target_col, "_val")
obs_col <- paste0(target_col, "_obs")
# Negate the outcome column: left-censored → right-censored
# (below LOD becomes above a threshold, which rfsrc handles natively)
df_model <- df %>%
mutate(
neg_val = -.data[[val_col]],    # flip sign
obs_flag = .data[[obs_col]]     # keep flag as-is (0 = censored, 1 = observed)
) %>%
select(-all_of(c(val_col, obs_col)))  # remove originals
model <- rfsrc(
formula   = Surv(neg_val, obs_flag) ~ .,   # plain Surv(), no type needed
data      = df_model,
ntree     = 500,
nodesize  = 5,
splitrule = "logrankscore"
)
# Impute, then flip sign back to original scale
imputed_neg <- impute(model)[["neg_val"]]
df %>% mutate("{val_col}" := -imputed_neg)
}
# --- Re-run ---
cI_imputed <- reduce(lod_cols_cI, impute_lod_col, .init = cI_clean)
