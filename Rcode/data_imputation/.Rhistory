# --- Impute each LOD column via negation trick ---
impute_lod_col <- function(df, target_col) {
val_col <- paste0(target_col, "_val")
obs_col <- paste0(target_col, "_obs")
df_model <- df %>%
mutate(
neg_val  = -.data[[val_col]],
obs_flag = .data[[obs_col]]
) %>%
select(-all_of(c(val_col, obs_col)))
model <- rfsrc(
formula   = Surv(neg_val, obs_flag) ~ .,
data      = df_model,
ntree     = 500,
nodesize  = 5,
splitrule = "logrankscore"
)
# Pass data explicitly to impute()
imputed_neg <- impute(model, data = df_model)[["neg_val"]]
df %>% mutate("{val_col}" := -imputed_neg)
}
# --- Run imputation ---
cI_imputed <- reduce(lod_cols_cI, impute_lod_col, .init = cI_clean)
cI_imputed
cI_imputed["Si"]
cI_imputed["Si_val"]
sI_imputed <- reduce(lod_cols_sI, impute_lod_col, .init = sI_clean)
# --- Save csv files ---
write_csv(cI_imputed, "output/cI_imputed.csv")
write_csv(sI_imputed, "output/sI_imputed.csv")
# --- Bind metadata columns back ---
cI_final <- bind_cols(cI[, 1:16], cI_imputed)
sI_final <- bind_cols(sI[, 1:16], sI_imputed)
# --- Save to csv ---
write_csv(cI_final, "output/cI_imputed.csv")
write_csv(sI_final, "output/sI_imputed.csv")
# Add metadata back & only keep value columns (and revert their names back to original)
clean_imputed <- function(df, lod_cols) {
df %>%
select(-ends_with("_obs")) %>%
rename_with(~ str_remove(., "_val"), ends_with("_val"))
}
cI_final <- bind_cols(cI[, 1:16], clean_imputed(cI_imputed, lod_cols_cI))
sI_final <- bind_cols(sI[, 1:16], clean_imputed(sI_imputed, lod_cols_sI))
# --- Save to csv ---
write_csv(cI_final, "output/cI_imputed.csv")
