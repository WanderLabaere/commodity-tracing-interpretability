library(zCompositions)
# This script runs the tobit random forest imputation for LOD values
# install.packages("AER") # Instead of tobit
# install.packages("mice")
install.packages("zCompositions")
library(zCompositions)
# --- Build value matrix: censored observations get their LOD value ---
# (zCompositions expects the detection limit value in place of censored obs)
val_cols_cI <- cI_clean %>% select(ends_with("_val"))
cI_clean
# --- Build value matrix: censored observations get their LOD value ---
# (zCompositions expects the detection limit value in place of censored obs)
val_cols_cI <- cI_clean %>% select(ends_with("_val"))
# --- Build value matrix: censored observations get their LOD value ---
# (zCompositions expects the detection limit value in place of censored obs)
val_cols_cI <- cI_clean %>% dplyr::select(ends_with("_val"))
obs_cols_cI <- cI_clean %>% dplyr::select(ends_with("_obs"))
# --- Build detection limit matrix ---
# For each censored cell, the LOD = the stored value (since we kept it from "<0.0007")
# For observed cells, dl value doesn't matter but must be <= observed value
dl_matrix_cI <- as.matrix(val_cols_cI)   # LOD values already stored correctly
dl_matrix_cI
# --- Replace censored values with 0 so lrEM knows they're censored ---
# lrEM uses label=0 by default to identify censored values
X_matrix_cI <- as.matrix(val_cols_cI)
X_matrix_cI[as.matrix(obs_cols_cI) == 0] <- 0   # 0 = censored in zCompositions
# ⚠️ VERIFY: check ?lrEM — specifically:
# 1. Whether label=0 is correct convention
# 2. Whether dl matrix should contain LOD values for ALL cells or just censored ones
result_cI <- lrEM(
X     = X_matrix_cI,
label = 0,           # value used to mark censored observations
dl    = dl_matrix_cI # matrix of detection limits
)
# Build full value matrix — non-LOD cols are already numeric, just need LOD cols parsed
X_matrix_cI <- as.matrix(cI_clean %>%
dplyr::select(ends_with("_val")) %>%
# join back with non-LOD numeric cols
bind_cols(dplyr::select(cI_clean, -ends_with("_val"), -ends_with("_obs"))))
# Build matching DL matrix — for non-LOD cols, set dl to 0 (always observed)
non_lod_matrix_cI <- matrix(
0,
nrow = nrow(X_matrix_cI),
ncol = ncol(dplyr::select(cI_clean, -ends_with("_val"), -ends_with("_obs")))
)
dl_matrix_cI <- cbind(as.matrix(dplyr::select(cI_clean, ends_with("_val"))), non_lod_matrix_cI)
# Mark censored values as 0 in X
obs_matrix_cI <- as.matrix(dplyr::select(cI_clean, ends_with("_obs")))
X_matrix_cI[, 1:ncol(obs_matrix_cI)][obs_matrix_cI == 0] <- 0
result_cI <- lrEM(
X        = X_matrix_cI,
label    = 0,
dl       = dl_matrix_cI,
z.delete = TRUE   # keep deleting >80% censored rows, they're unreliable anyway
)
# Check which rows are getting deleted
high_censor_rows <- which(rowMeans(obs_matrix_cI == 0) > 0.8)
cI[high_censor_rows, 1:16]   # look at their metadata
# Check which rows are getting deleted
