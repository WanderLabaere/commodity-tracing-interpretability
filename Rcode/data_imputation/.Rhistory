tX_50_pct_num <- tX_50_pct[, 14:ncol(tX_50_pct)]
# Run the imputation and averaging
completed_tX_0.5_pct_num <- impute_and_average(tX_0.5_pct_num, m = 5)
# Run the imputation and averaging
