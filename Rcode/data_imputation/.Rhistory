# Custom implementation of MICE
mice.impute.leftcens_factory <- function(lod_value) {
function(y, ry, x, ...) {
fit <- lm(y[ry] ~ x[ry, ])
beta <- coef(fit)
sigma <- summary(fit)$sigma
mu <- cbind(1, x[!ry, ]) %*% beta
imp <- truncnorm::rtruncnorm(
n = sum(!ry),
a = -Inf,
b = lod_value,
mean = mu,
sd = sigma
)
return(imp)
}
}
lod_vars <- names(lod[!is.na(lod)])
