library(readr)
# --- Load data ---
cI <- read_csv("data/cI_filtered.csv")
sI <- read_csv("data/sI_filtered.csv")
# --- Select numerical columns ---
cI_num <- cI[, 17:dim(cI)[2]]
sI_num <- sI[, 17:dim(sI)[2]]
# Detect LOD thresholds
lod <- sapply(cI_num, min, na.rm = TRUE)
lod
lod <- numeric(ncol(cI_num))
names(lod) <- names(cI_num)
for (j in seq_along(cI_num)) {
col <- cI_num[[j]]
# detect censored values
censored <- str_detect(col, "^<")
if (any(censored)) {
# extract numeric LOD
lod[j] <- as.numeric(str_remove(col[censored][1], "<"))
# convert values
col[censored] <- NA
col <- as.numeric(col)
} else {
lod[j] <- NA
col <- as.numeric(col)
}
cI_num[[j]] <- col
}
lod
# Custom implementation of MICE
mice.impute.leftcens <- function(y, ry, x, lod_value, ...) {
# Fit regression on observed values
fit <- lm(y[ry] ~ x[ry, ])
beta <- coef(fit)
sigma <- summary(fit)$sigma
# Predicted mean for missing rows
mu <- cbind(1, x[!ry, ]) %*% beta
# Draw from truncated normal
imp <- rtruncnorm(
n = sum(!ry),
a = -Inf,
b = lod_value,
mean = mu,
sd = sigma
)
return(imp)
}
# RUN MICE
# MICE setup
init <- mice(cI_num, maxit = 0)
meth <- init$method
pred <- init$predictorMatrix
# Use custom method for every variable
for (j in seq_along(meth)) {
meth[j] <- "leftcens"
}
# Run multiple imputation
imp <- mice(
cI_num,
method = meth,
predictorMatrix = pred,
m = 5,
maxit = 10
)
# Custom implementation of MICE
mice.impute.leftcens <- function(y, ry, x, ...) {
# current variable name
varname <- colnames(x)[1]
# detection limit for this variable
lod_value <- lod_values[varname]
# fit regression on observed values
fit <- lm(y[ry] ~ x[ry, ])
beta <- coef(fit)
sigma <- summary(fit)$sigma
# predicted means for missing rows
mu <- cbind(1, x[!ry, ]) %*% beta
# truncated draws
imp <- truncnorm::rtruncnorm(
n = sum(!ry),
a = -Inf,
b = lod_value,
mean = mu,
sd = sigma
)
return(imp)
}
